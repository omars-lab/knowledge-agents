# Knowledge Agents — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# PostgreSQL host port (avoid conflict with private-site umami-db on 5432)
POSTGRES_HOST_PORT=5433

# Langfuse LLM Observability
LANGFUSE_ADMIN_EMAIL=admin@localhost.dev          # Initial admin email
LANGFUSE_ADMIN_PASSWORD=changeme                  # Initial admin password (change this!)
LANGFUSE_NEXTAUTH_SECRET=changeme                 # NextAuth session secret (openssl rand -base64 32)
LANGFUSE_ENCRYPTION_KEY=changeme                  # 64-char hex encryption key (openssl rand -hex 32)
LANGFUSE_URL=http://localhost:3210                # Public URL (set to https://langfuse.bytesofpurpose.com in prod)

# Neo4j (optional — defaults in compose)
# NEO4J_URI=bolt://host.docker.internal:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password
# NEO4J_DATABASE=neo4j

# LM Studio (optional — defaults to mac-studio.local:1234)
# LM_STUDIO_HOST=mac-studio.local
# LM_STUDIO_PORT=1234

# Anthropic API Key (for claude-agent service)
# ANTHROPIC_API_KEY=sk-ant-...
