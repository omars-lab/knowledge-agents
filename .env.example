# Knowledge Agents — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# Generate secure passwords with: openssl rand -base64 24

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme                        # PostgreSQL password (used in all DATABASE_URL connections)
POSTGRES_HOST_PORT=5433                           # Host port (avoid conflict with private-site on 5432)

# ── Neo4j ─────────────────────────────────────────────────────────────────
NEO4J_PASSWORD=changeme                           # Neo4j auth password

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme                   # Grafana admin UI password

# ── ClickHouse ────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=changeme                      # ClickHouse default user password

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────
MINIO_ROOT_PASSWORD=changeme                      # MinIO root password (min 8 chars)

# ── Langfuse LLM Observability ────────────────────────────────────────────
LANGFUSE_ADMIN_EMAIL=admin@localhost.dev           # Initial admin email
LANGFUSE_ADMIN_PASSWORD=changeme                  # Initial admin password
LANGFUSE_NEXTAUTH_SECRET=changeme                 # NextAuth session secret (openssl rand -base64 32)
LANGFUSE_ENCRYPTION_KEY=changeme                  # 64-char hex (openssl rand -hex 32)
LANGFUSE_URL=http://localhost:3210                # Public URL (https://langfuse.bytesofpurpose.com in prod)
LANGFUSE_PROJECT_PUBLIC_KEY=pk-lf-changeme        # Langfuse project public key
LANGFUSE_PROJECT_SECRET_KEY=sk-lf-changeme        # Langfuse project secret key

# ── API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                                # Anthropic API key for claude-agent
